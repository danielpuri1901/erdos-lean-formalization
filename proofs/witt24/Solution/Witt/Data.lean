/-- Number of set bits among the lowest `n` bits of `x`. -/
def pc : Nat → Nat → Nat
  | 0, _ => 0
  | n + 1, x => x % 2 + pc n (x / 2)

/-- Every octad has exactly 8 bits and fits in 24 bits. -/
def cardsOK : Bool := octads.all fun m => pc 24 m == 8 && decide (m < 2 ^ 24)

/-- Clear the lowest set bit. -/
def clr (x : Nat) : Nat := x &&& (x - 1)

/-- Two masks share at most 4 bits: clearing the lowest set bit 4 times leaves nothing. -/
def pairOK (a b : Nat) : Bool := clr (clr (clr (clr (a &&& b)))) == 0

/-- Row `i`: the octad at position `i` meets every later octad in at most 4 points. -/
def rowOK (i : Nat) : Bool := (octads.drop (i + 1)).all (pairOK (octads.getD i 0))

/-- Rows `lo, ..., lo + n - 1` are fine. -/
def rowsOK (lo n : Nat) : Bool := (List.range' lo n).all rowOK

end Witt
